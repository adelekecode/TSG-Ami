{
  "name": "ami-worker",
  "version": "1.0.0",
  "description": "Ami tenant concierge — Cloudflare Worker and D1",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply ami-db --local",
    "db:seed": "wrangler d1 execute ami-db --local --file seed.sql",
    "test": "tsx scripts/smoke.ts",
    "deploy": "wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  },
  "private": true,
  "type": "module"
}
